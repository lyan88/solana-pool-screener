# Salin ke .env lalu isi. Jangan commit .env.

# Telegram (wajib untuk alert)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
DRY_RUN=false
TELEGRAM_MIN_INTERVAL_SEC=3
TELEGRAM_MAX_PER_HOUR=20
TELEGRAM_MAX_PER_DAY=100

# Filter utama
MAX_AGE_SEC=600
MIN_AGE_SEC=0
MIN_LIQ_USD=5000
MIN_MC_USD=8000
MAX_MC_USD=100000
TOP10_MAX_PCT=35
MIN_TOP10_HOLDERS=10
MIN_TOP10_TOTAL_PCT=5
MIN_UNIQUE_BUYERS=15
BUYER_WINDOW_SEC=120

REQUIRE_MINT_REVOKED=true
REQUIRE_FREEZE_REVOKED=true
REJECT_RUGGED=true

# LP: terima "locked" sebagai aman. Set false kalau hanya mau LP burned.
LP_MIN_LOCKED_PCT=99
LP_ACCEPT_LOCKED=true

# Sumber data & laju
SCAN_PAGES=2
GECKO_MIN_INTERVAL=6
RUGCHECK_MIN_INTERVAL=2
METEORA_MIN_INTERVAL=0.2
METEORA_MIN_TVL_USD=1000
HTTP_TIMEOUT=25
HTTP_RETRIES=3
SECURITY_CACHE_SEC=120

# Pengukuran hasil (detik): +5m, +30m, +1j, +6j
OUTCOME_HORIZONS=300,1800,3600,21600
WIN_MFE_MIN=1.5
TRACK_MAX_ALERTS=25
TRACK_LOOKBACK_DAYS=7
TRACK_MAX_ATTEMPTS=3
REPORT_HOURS=24

# Operasional
SCAN_INTERVAL_SEC=120
LOG_KEEP_DAYS=14
