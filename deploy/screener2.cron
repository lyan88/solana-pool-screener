SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=UTC

# screener2 — tiap 2 menit. flock mencegah tumpang tindih.
*/2 * * * * screener cd /opt/screener2 && flock -n /opt/screener2/locks/scan.lock /usr/bin/python3 scanner.py >> /opt/screener2/logs/scan.log 2>&1

# Pelacak hasil: catat harga +5m/+30m/+1j/+6j setelah alert.
*/5 * * * * screener cd /opt/screener2 && flock -n /opt/screener2/locks/track.lock /usr/bin/python3 track.py >> /opt/screener2/logs/track.log 2>&1

# Laporan harian ke Telegram (07:00 UTC = 14:00 WIB).
0 7 * * * screener cd /opt/screener2 && /usr/bin/python3 report.py --telegram >> /opt/screener2/logs/report.log 2>&1
